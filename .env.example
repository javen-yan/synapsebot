# Environment variables for SynapseBot
# Copy this file to .env and fill in your values

# LLM API Configuration (supports any OpenAI-compatible API)
# Examples: DeepSeek, OpenAI, Azure OpenAI, Ollama, LM Studio, Together AI, Groq, etc.
DEEPSEEK_API_KEY=your-api-key-here
# Or use: OPENAI_API_KEY, AZURE_API_KEY, etc. (configure in config.yaml)


# Slack Integration (Optional)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_APP_TOKEN=xapp-your-slack-app-token

# Feishu Integration (Optional)
FEISHU_APP_ID=cli_your-feishu-app-id
FEISHU_APP_SECRET=your-feishu-app-secret

# Docker Configuration
SYNAPSEBOT_IMAGE=synapsebot:local
SYNAPSEBOT_CONFIG_DIR=./config.yaml
SYNAPSEBOT_DATA_DIR=./data
SYNAPSEBOT_API_PORT=8000
SYNAPSEBOT_WEB_PORT=3000

# Next.js Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
