# Environment variables for SynapseBot
# Copy this file to .env and fill in your values

# LLM Configuration (Required)
# Works with any OpenAI-compatible API (OpenAI, DeepSeek, Azure, Ollama, etc.)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4
# See config.example.yaml for more provider examples

# Slack Integration (Optional)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_APP_TOKEN=xapp-your-slack-app-token

# Feishu Integration (Optional)
FEISHU_APP_ID=cli_your-feishu-app-id
FEISHU_APP_SECRET=your-feishu-app-secret

# Docker Configuration
SYNAPSEBOT_IMAGE=synapsebot:local
SYNAPSEBOT_CONFIG_DIR=./config.yaml
SYNAPSEBOT_DATA_DIR=./data
SYNAPSEBOT_API_PORT=8000
SYNAPSEBOT_WEB_PORT=3000

# Next.js Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
